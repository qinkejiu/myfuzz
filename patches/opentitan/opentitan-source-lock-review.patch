+  "component_id": "opentitan_spi_device",
+  "kind": "peripheral",
+  "description": "Pinned independent OpenTitan SPI Device with native TL-UL register/SRAM interface, external SPI slave pins, and eight interrupt outputs; the wrapper fixes alert, RACL, passthrough, RAM configuration, and scan inputs.",

__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

build/
target/
out/
tmp/
temp/

*.log
*.vcd
*.fst
*.wave

/runs/
/artifacts/
/.worktrees/
/.superpowers/cache/

# Local development inputs and generated evidence; keep these on disk.
/.downloads/
/.myfuzz-*/
**/.myfuzz-elaboration-*/
/camp-*/
/archive/
/deliverables/
/.scratch/
*:Zone.Identifier
/third_party/boom_upstream_reference/
/trace_hart_0.dasm
/third_party/rfuzz/upstream/.tools/
/third_party/rfuzz/upstream/rfuzz_reference/results/
/third_party/rfuzz/upstream/rfuzz_reference/fuzzer/logs/
# Only the RFuzz client source is vendored; the rest of this local reference
# checkout is retained locally, not mirrored into this repository.
/third_party/rfuzz/upstream/rfuzz_reference/*
!/third_party/rfuzz/upstream/rfuzz_reference/fuzzer/

# Elaboration/verification scratch directories created in the repository root by
# the CVW contract verifier and by ad-hoc elaboration runs.  They are per-run
# temporary trees, never sources.
/.cvw-verify-*/

# The .superpowers working area holds per-run build caches, Verilator object
# trees, probe binaries and one-off probe sources (gigabytes).  Only its written
# records are sources, so the whole directory is disregarded with a single
# exception for .superpowers/sdd, which IS tracked (its files stay in the index,
# and an explicit negation keeps them reachable).
/.superpowers/*
!/.superpowers/sdd/

# Scratch profile directories that scenario tests create under configs/ via
# TemporaryDirectory(prefix='.alias-test-').  A test run that is interrupted
# leaves them behind; they are fixtures of no run, so they are neither tracked
# nor kept.
/configs/.alias-test-*/

# --- 2026-11-03 cleanup: keep multi-gigabyte experiment/evidence bulk on disk ---
# `runs/` is already disregarded above.  `research/` holds the 2026-10 input-strategy
# audit's raw experiment trees (tens of GB); its written reports are cited from
# docs/ by path and stay on disk, but the run bulk is not mirrored into git.
/research/
# Local git-object bundles (six ~140 MB tarballs) that back the compiled-path source
# metadata; the reader works against this checkout, so they stay on disk only.
/source-git-metadata/
# Scratch directories earlier rounds left in the repository root (source copies of
# probe hosts, compiled probes, elaboration audit trees).  They are never sources.
/.tmp-*/
/.myfuzz-audit-*/
/.sdd/
/.backups/
# Raw evidence bundles under docs/reports/evidence/ are local reproduction material:
# compressed captures and per-run JSON traces are frequently hundreds of megabytes.
# The written reports (docs/reports/*.md) and the small manifests already in the
# index stay tracked; new bulk under this tree is not added automatically.  Use
# `git add -f <path>` for a specific small artefact that must be versioned.
# The whole raw-evidence tree is local reproduction material; the small files already
# in the index stay tracked, everything else under it is disregarded.
/docs/reports/evidence/
/docs/reports/evidence/**/*.gz
/docs/reports/evidence/**/*.tar
/docs/reports/evidence/**/*.tar.gz
/docs/reports/evidence/**/*.tgz
/docs/reports/evidence/**/*.zip
/docs/reports/evidence/**/*.gch
/docs/reports/evidence/**/*.o
/docs/reports/evidence/**/*.a
/docs/reports/evidence/**/*.so
/docs/reports/evidence/**/*.vcd
/docs/reports/evidence/**/*.fst
/docs/reports/evidence/**/*.json

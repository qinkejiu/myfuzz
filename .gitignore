__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

build/
target/
out/
tmp/
temp/

*.log
*.vcd
*.fst
*.wave

/runs/
/artifacts/
/.worktrees/
/.superpowers/cache/

# Local development inputs and generated evidence; keep these on disk.
/.downloads/
/.myfuzz-*/
**/.myfuzz-elaboration-*/
/camp-*/
/archive/
/deliverables/
/.scratch/
*:Zone.Identifier
/third_party/boom_upstream_reference/
/trace_hart_0.dasm
/third_party/rfuzz/upstream/.tools/
/third_party/rfuzz/upstream/rfuzz_reference/results/
/third_party/rfuzz/upstream/rfuzz_reference/fuzzer/logs/
# Only the RFuzz client source is vendored; the rest of this local reference
# checkout is retained locally, not mirrored into this repository.
/third_party/rfuzz/upstream/rfuzz_reference/*
!/third_party/rfuzz/upstream/rfuzz_reference/fuzzer/

# Elaboration/verification scratch directories created in the repository root by
# the CVW contract verifier and by ad-hoc elaboration runs.  They are per-run
# temporary trees, never sources.
/.cvw-verify-*/

# The .superpowers working area holds per-run build caches, Verilator object
# trees and probe binaries (gigabytes).  Only its written records are sources, so
# the rules name the ignored entries instead of the directory: a directory-level
# exclusion would also hide .superpowers/sdd, which IS tracked.
/.superpowers/cache/
/.superpowers/cvw-*/
/.superpowers/rfuzz-*/
/.superpowers/ahb/
/.superpowers/patched/

# Scratch profile directories that scenario tests create under configs/ via
# TemporaryDirectory(prefix='.alias-test-').  A test run that is interrupted
# leaves them behind; they are fixtures of no run, so they are neither tracked
# nor kept.
/configs/.alias-test-*/

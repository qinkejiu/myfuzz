{
  "name": "cva6_enhanced",
  "top": "cva6",
  "project_root": "third_party/rfuzz/upstream/cva6",
  "flist": "third_party/rfuzz/upstream/cva6/sources.f",
  "out_dir": "runs/designs/cva6_enhanced",
  "instrumentation": {
    "coverage_port": "__vi_coverage",
    "signal_prefix": "__vi_cov",
    "branch": {
      "if": true,
      "case": true,
      "case_default": true,
      "else_if": true,
      "else_missing": true
    },
    "statement": {
      "block_enter": true,
      "procedural_assign": true,
      "call": true,
      "control": true
    },
    "loop": {
      "body": true,
      "single_statement": true
    },
    "expression": {
      "ternary": true,
      "condition": true,
      "toggle": true
    },
    "assertion": {
      "hit": true,
      "metadata": true
    },
    "static": {
      "generate": true
    },
    "hierarchy": {
      "propagate_to_top": true
    }
  },
  "verilator_args": [
    "-DSYNTHESIS",
    "--bbox-unsup",
    "--timing",
    "-Wno-ASCRANGE",
    "-Wno-WIDTH",
    "-Wno-MULTIDRIVEN",
    "-Wno-LATCH",
    "-Wno-PINMISSING",
    "--unroll-count",
    "10000"
  ]
}

  "evidence": {
    "semantics": [
      "The pinned uart.sv TL-UL target has one 32-bit bus, one serial RX pin, TX/TX-enable outputs, nine native interrupt outputs, and a trigger output.",
      "The local wrapper fixes alert receiver and RACL policy to source-defined defaults, disables RACL, and exposes alert/RACL outputs.",
      "TL-UL packed fields map to top_pkg and tlul_pkg widths in the fixed source.",
      "UART register offsets follow pinned uart/rtl/uart_reg_pkg.sv."
    ],
    "verified": [
      "The source lock and exact local scalar wrapper gate all source bytes before build.",
      "The 4096-byte local target window covers the complete UART register map."
    ],
    "unknown": [
      "Serial TX/RX, FIFO and native IRQ behavior require real runtime acceptance; structural admission alone makes no such claim."
    ]
  }

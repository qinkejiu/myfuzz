  "evidence": {
    "semantics": [
      "The pinned rv_timer.sv TL-UL target has one 32-bit bus and one active-high level IRQ from prim_intr_hw.",
      "The wrapper fixes alert receiver and RACL policies to source-defined defaults, disables RACL, and exposes alert and RACL outputs.",
      "The TL-UL packed member mapping and widths match top_pkg and tlul_pkg of pinned source.",
      "The timer register offsets are from pinned rv_timer/rtl/rv_timer_reg_pkg.sv."
    ],
    "verified": [
      "The local full scalar wrapper binds every top port; all exported outputs remain observable.",
      "The 4096-byte window covers the highest register at offset 0x11c."

  "interrupts": [
    {
      "endpoint_id": "uart.interrupts",
      "role": "rx",
      "polarity": "active_high",
      "trigger": "level",
      "clock_domain": "core",
      "hold": "Combinational level wired straight to the RX FIFO status bit: `assign o_uart_rx_int = rxf_status[0];` (wbuart.v:212), and ufifo.v:297-303 defines bit 0 as 'the FIFO can be read from' for a receive FIFO. It stays asserted for as long as the RX FIFO is non-empty, and it is not latched or edge-detected.",
      "clear": "Clears when the condition disappears, i.e. when the RX FIFO is drained by reads of RXREG (wbuart.v:236-239)."
    },
    {
      "endpoint_id": "uart.interrupts",
      "role": "rxfifo",
      "polarity": "active_high",
      "trigger": "level",
      "clock_domain": "core",
      "hold": "Combinational level: `assign o_uart_rxfifo_int = rxf_status[1];` (wbuart.v:207); ufifo.v:281 assigns w_half_full = r_fill[LGFLEN-1], so bit 1 means the RX FIFO is at least half full.",
      "clear": "Clears when the RX FIFO drops below half full, i.e. after enough RXREG reads."
    },
    {
      "endpoint_id": "uart.interrupts",
      "role": "tx",
      "polarity": "active_high",
      "trigger": "level",
      "clock_domain": "core",
      "hold": "Combinational level: `assign o_uart_tx_int = txf_status[0];` (wbuart.v:365); ufifo.v:297-303 defines bit 0 for a non-receive FIFO as 'the FIFO can be written to', so it is asserted while the TX FIFO has at least one free slot.",
      "clear": "Clears when the TX FIFO becomes full, i.e. after enough TXREG writes; it re-asserts as the transmitter drains the FIFO."
    },
    {
      "endpoint_id": "uart.interrupts",
      "role": "txfifo",
      "polarity": "active_high",
      "trigger": "level",
      "clock_domain": "core",
      "hold": "Combinational level: `assign o_uart_txfifo_int = txf_status[1];` (wbuart.v:369), i.e. the TX FIFO is less than half full (ufifo.v:281).",
      "clear": "Clears when the TX FIFO reaches half full or more."
    }
  ],
  "port_actions": [],
  "evidence": {
    "semantics": [
      "All 29 top ports are physical facts from pinned axiluart Verilator elaboration.",
      "S_AXI_AWADDR[3:2] and S_AXI_ARADDR[3:2] select four 32-bit registers. AXI responses are distinct B and R channels; S_AXI_BRESP and S_AXI_RRESP are tied to OKAY in the RTL.",
      "AW and W are independently accepted by the AXI4-Lite target. The local executor must preserve both handshakes and wait for the B response before reporting completion.",
      "RX and TX remain physical serial pins; host input must come from a bounded declared peer, and output must be sampled from RTL."
    ]
  }

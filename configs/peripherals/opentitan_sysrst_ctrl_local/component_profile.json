  "evidence": {
    "clocks": "sysrst_ctrl.sv declares the independent 24 MHz configuration and 200 kHz AON clock inputs with one reset per domain.",
    "key0_h2l": "Pinned HJSON and generated register package define KEY_INTR_CTL key0 H2L at 0x44 bit 1, debounce at 0x48, PIN_IN_VALUE at 0x40, and KEY_INTR_STATUS key0 H2L at 0xa8 bit 1.",
    "irq_cdc": "sysrst_ctrl_intr.sv stages AON key events, sends them through prim_sync_reqack to the core clock, then writes status consumed by the native aggregate interrupt primitive.",
    "reset_feedback": "rst_req_o is observed as a DUT output; the scalar wrapper does not connect it to either reset input."
  }

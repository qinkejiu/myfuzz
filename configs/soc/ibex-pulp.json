{
  "schema_version": "soc_render_config.v1",
  "config_id": "ibex-pulp",
  "status": "source_locked_render_profile",
  "cpu": {
    "id": "ibex",
    "source_lock": "ibex",
    "top_module": "ibex_top",
    "interface": "configs/cpus/ibex/official_core_interface_description.json",
    "protocol": ["obi", "1"],
    "xlen": 32,
    "extensions": ["I", "M", "C"],
    "parameters": {
      "PMPEnable": 0,
      "RV32E": 0,
      "ICache": 0,
      "SecureIbex": 0
    },
    "reset_vector": 65536,
    "source_provenance": "configs/soc/sources.lock.json#/components/ibex"
  },
  "peripherals": [
    {
      "id": "pulp_gpio",
      "source_lock": "pulp_gpio",
      "top_module": "apb_gpio",
      "family": "pulp",
      "protocol": ["apb", "3"],
      "target_id": "gpio0_win",
      "window": {"base": 1073741824, "size": 4096},
      "parameters": {"APB_ADDR_WIDTH": 12, "PAD_NUM": 32, "NBIT_PADCFG": 4},
      "closure": "configs/soc/closures/pulp_gpio.json",
      "runtime_status": "runtime_unverified"
    },
    {
      "id": "pulp_spi",
      "source_lock": "pulp_spi",
      "top_module": "apb_spi_master",
      "family": "pulp",
      "protocol": ["apb", "3"],
      "target_id": "spi0_win",
      "window": {"base": 1073745920, "size": 4096},
      "parameters": {"APB_ADDR_WIDTH": 12, "BUFFER_DEPTH": 10},
      "closure": "configs/soc/closures/pulp_spi.json",
      "runtime_status": "runtime_unverified"
    }
  ],
  "memory_regions": [
    {
      "region_id": "rom0",
      "base": 65536,
      "size": 32768,
      "physical_memory_id": "boot_rom",
      "permissions": {"read": true, "write": false, "execute": true},
      "initialization_policy": "preload"
    },
    {
      "region_id": "ram0",
      "base": 2147483648,
      "size": 65536,
      "physical_memory_id": "main_ram",
      "permissions": {"read": true, "write": true, "execute": true},
      "initialization_policy": "on_demand"
    }
  ],
  "environment_links": [
    {
      "link_id": "gpio0_pins",
      "component_id": "pulp_gpio",
      "protocol": ["gpio-event", "1"],
      "parameters": {"width": 8, "synchronizer_stages": 3, "event_kind": "edge"}
    },
    {
      "link_id": "spi0_miso",
      "component_id": "pulp_spi",
      "protocol": ["spi-miso", "1"],
      "parameters": {"bits": 8, "cpol": 0, "cpha": 0, "msb_first": true}
    }
  ],
  "interrupt_routes": [
    {
      "route_id": "gpio0_irq",
      "source": {"component_id": "pulp_gpio", "signal": "interrupt", "trigger": "edge"},
      "sink": {"master_id": "cpu_data", "irq": 3},
      "mask_ack": {"register": "gpio0.intstatus", "semantics": "read-to-clear"}
    },
    {
      "route_id": "spi0_irq",
      "source": {"component_id": "pulp_spi", "signal": "events_o", "trigger": "edge"},
      "sink": {"master_id": "cpu_data", "irq": 4},
      "mask_ack": {"register": "spi0.intcfg", "semantics": "explicit-complete"}
    }
  ],
  "modes": ["cpu_only", "mmio_only", "mixed"],
  "harness": {
    "raw_input": "soc_stimulus.v1",
    "environment_driver": "environment_pins",
    "synthetic_master": "fuzz_mmio_master",
    "irq_router": "soc_irq_router",
    "boot_program": "soc_boot.S",
    "replay_identity": ["source_lock", "plan_hash", "layout_hash", "render_hash", "tool"]
  },
  "acceptance": {
    "requires_real_cpu": true,
    "requires_real_peripherals": true,
    "requires_elaboration": true,
    "requires_runtime": true,
    "required_observations": [
      "gpio_output_state", "spi_miso_bits", "real_irq", "cpu_mmio_transaction",
      "fuzz_mmio_transaction", "source_target_transaction_identity"
    ],
    "environment": "MYFUZZ_SOC_REAL=1"
  },
  "provenance": {
    "sources": "configs/soc/sources.lock.json",
    "closures": "configs/soc/closures",
    "plan": "docs/superpowers/plans/2026-09-14-soc-composition-and-fuzz.md#P10"
  }
}

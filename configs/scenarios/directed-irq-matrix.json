{
  "schema_version": "directed_irq_matrix.v1",
  "scope": "directed-and-native-ready-irq-validation",
  "software_scope": "pure-reducer-and-preparation-gates-only",
  "native_scope": "script-driven-native-cases-run-only-in-a-frozen-window-by-the-lead",
  "notes": [
    "This file declares cases and evidence layers. It never counts a software gate as a native result.",
    "Every native_ready case must be executable by scripts/run_directed_irq_native.py through an existing public factory/runner.",
    "A case that no public native runner can build is declared native_ready=false with the exact refusal code.",
    "claimed_layers must be a subset of measurable_layers; unavailable lists what this case cannot measure today.",
    "The four directed cases (reset, exception, two-source, unique-per-member) each declare their own public native runner; scripts/run_directed_irq_native.py executes the declared runner but its built-in layer derivation currently covers only the single-take transport cases, so those four cite the dedicated runner's summary.json as evidence."
  ],
  "evidence_layers": {
    "source_verification": "the CPU source-lock / native-IRQ source contract verification document",
    "declared_output_mapping": "declared-output.v1 physical port and runtime wire mapping produced by verify_group_sessions",
    "irq_group_unique_attribution": "irq_group_delivery frame with attribution_status unique and one exact source id",
    "irq_group_joint_attribution": "irq_group_delivery frame whose active_sources has more than one member",
    "cpu_native_sample": "cpu_external_irq_sample carrying expected/actual pre/post input",
    "cpu_native_take": "cpu_external_irq_taken carrying take_key and receipt identity",
    "cpu_retirement_serial": "cpu_retire post pre_post_rising retirement serial observation",
    "irq_serial_certificate": "exact nonzero decision/retirement serial join (irq_serial_certificate.v1)",
    "reset_barrier": "measured reset barrier journal event (reset_barrier/cpu_reset/gpio_reset_resource)",
    "post_reset_fresh_epoch": "post-reset observation admitted only with the advanced reset epoch",
    "no_lineage_after_reset": "zero certificates reachable from pre-reset lineage",
    "no_lineage_from_sync_exception": "a synchronous exception cause mints no IRQ decision serial and no take",
    "debug_nmi_diversion_refused": "debug/NMI diversion observations refuse retirement lineage",
    "unknown_origin_no_credit": "a member without an exact native source reference yields no attribution",
    "no_delivery_frame_no_join": "a take without its irq_group_delivery frame cannot be joined",
    "overrun_or_cancelled_no_credit": "an overrun or reset-cancelled pulse yields no delivery and no credit",
    "peripheral_prefix_coverage": "offline Verilator line/block coverage of the saved peripheral prefix",
    "comparability_document": "saved-prefix coverage comparability document with explicit conditions"
  },

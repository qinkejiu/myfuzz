{
  "schema_version": "composition_request.v1",
  "request_id": "ibex-pulp-gpio-spi",
  "description": "Real pinned Ibex instruction and data OBI master with real pinned PULP APB GPIO and SPI targets. Peripheral pulse events are observed without interrupt routing.",
  "cpu": {
    "instance_id": "cpu0",
    "profile": "configs/cpus/ibex/component_profile.json",
    "parameters": {}
  },
  "peripherals": [
    {
      "instance_id": "gpio0",
      "profile": "configs/peripherals/pulp_gpio/component_profile.json",
      "parameters": {}
    },
    {
      "instance_id": "spi0",
      "profile": "configs/peripherals/pulp_spi/component_profile.json",
      "parameters": {}
    }
  ],
  "peer_models": [
    {
      "instance_id": "spi0",
      "endpoint_id": "spi.pins",
      "attach": true,
      "parameters": {}
    }
  ],
  "memory": [
    {
      "region_id": "rom0",
      "base": 65536,
      "size": 32768,
      "permissions": {"read": true, "write": false, "execute": true},
      "physical_memory_id": "boot_rom",
      "initialization_policy": "rom"
    },
    {
      "region_id": "ram0",
      "base": 2147483648,
      "size": 65536,
      "permissions": {"read": true, "write": true, "execute": true},
      "physical_memory_id": "main_ram",
      "initialization_policy": "on_demand"
    }
  ],
  "address_policy": {
    "mmio_base": 1073741824,
    "mmio_limit": 1048576,
    "alignment": 4096
  },
  "clock": {"domain": "core", "frequency_hz": 50000000},
  "reset": {"domain": "sys_rst", "polarity": "active_low", "synchronous": false},
  "test_modes": ["cpu_only", "mmio_only", "mixed"],
  "provenance": {
    "author": "examples/soc_generation",
    "purpose": "compose pinned Ibex, PULP GPIO and PULP SPI profiles for fuzzing"
  }
}

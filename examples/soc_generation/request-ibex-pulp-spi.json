{
  "schema_version": "composition_request.v1",
  "request_id": "ibex-pulp-spi",
  "description": "Real pinned Ibex (ibex_top) as the instruction+data OBI master pair with the real pinned PULP apb_spi_master as the MMIO target. Memory regions, clock, reset and address policy are the same shape as request-ibex.json; the peripheral is selected by its component_profile.v1 alone, never by name.",
  "cpu": {
    "instance_id": "cpu0",
    "profile": "configs/cpus/ibex/component_profile.json",
    "parameters": {}
  },
  "peripherals": [
    {
      "instance_id": "spi0",
      "profile": "configs/peripherals/pulp_spi/component_profile.json",
      "parameters": {}
    }
  ],
  "memory": [
    {
      "region_id": "rom0",
      "base": 65536,
      "size": 32768,
      "permissions": {"read": true, "write": false, "execute": true},
      "physical_memory_id": "boot_rom",
      "initialization_policy": "rom"
    },
    {
      "region_id": "ram0",
      "base": 2147483648,
      "size": 65536,
      "permissions": {"read": true, "write": true, "execute": true},
      "physical_memory_id": "main_ram",
      "initialization_policy": "on_demand"
    }
  ],
  "address_policy": {
    "mmio_base": 1073741824,
    "mmio_limit": 1048576,
    "alignment": 4096
  },
  "clock": {"domain": "core", "frequency_hz": 50000000},
  "reset": {"domain": "sys_rst", "polarity": "active_low", "synchronous": false},
  "test_modes": ["cpu_only", "mmio_only", "mixed"],
  "provenance": {
    "author": "examples/soc_generation",
    "purpose": "real pinned CPU plus a real pinned peripheral profile composed and structure-audited"
  }
}

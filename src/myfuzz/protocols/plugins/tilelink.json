{
  "protocol_id": "tilelink",
  "version": "1",
  "legal_adapters": [],
  "fields": [
    {"field_id": "address", "direction": "host_to_device", "width": "address_width", "required": true, "reset_value": 0},
    {"field_id": "request", "direction": "host_to_device", "width": "request_width", "required": true, "reset_value": 0},
    {"field_id": "write_data", "direction": "host_to_device", "width": "data_width", "required": false, "reset_value": 0, "semantic_role": "data"},
    {"field_id": "read_data", "direction": "device_to_host", "width": "data_width", "required": true, "reset_value": 0, "semantic_role": "data"},
    {"field_id": "response", "direction": "device_to_host", "width": "response_width", "required": true, "reset_value": 0}
  ],
  "channel_relations": [
    {"relation_id": 1, "kind": "request_response_handshake", "field_ids": ["request", "response"]}
  ],
  "capability_limits": {
    "max_outstanding": 1,
    "byte_enable": false,
    "partial_write": false,
    "max_wait_cycles": 16,
    "x-role-vocabulary": "abstract-roles-only",
    "x-role-declaration": "configs/cpus/boom/interface_description.json",
    "x-channel-mapping": "not-declared"
  },
  "projection_actions": [
    {"action_id": 1, "field_ids": ["address"], "kind": "mask", "category": "address_validity"},
    {"action_id": 2, "field_ids": ["request"], "kind": "gate", "category": "protocol_legality", "max_cycles": 16},
    {"action_id": 3, "field_ids": ["write_data"], "kind": "fold_xor", "category": "dependency_consistency"}
  ],
  "temporal_rules": [
    {"rule_id": 1, "kind": "response_after_request", "antecedent_field_id": "request", "consequent_field_id": "response", "max_cycles": 16}
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myfuzz.local/schemas/scenario_result.v1.json",
  "title": "Persistent scenario result envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "testcase_id", "execution_id", "manifest_sha256", "genome_sha256", "status", "input_legality", "dut_violations", "environment_errors", "uncertain_effects", "local_cycles", "reset_counts", "pending_transactions", "coverage", "causal_chains", "resources", "evidence_paths"],
  "properties": {
    "schema_version": {"const": "scenario_result.v1"},
    "testcase_id": {"type": "string", "minLength": 1},
    "execution_id": {"type": "string", "minLength": 1},
    "manifest_sha256": {"$ref": "#/$defs/digest"},
    "genome_sha256": {"$ref": "#/$defs/digest"},
    "status": {"enum": ["ok", "input_invalid", "dut_violation_candidate", "environment_failure", "path_incomplete", "incomplete", "budget_exhausted", "uncertain_effect", "replay_mismatch"]},
    "input_legality": {"enum": ["valid", "invalid", "unknown"]},
    "dut_violations": {"type": "array", "items": {"type": "object"}},
    "environment_errors": {"type": "array", "items": {"type": "object"}},
    "uncertain_effects": {"type": "array", "items": {"type": "object"}},
    "local_cycles": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "reset_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "pending_transactions": {"type": "array", "items": {"type": "object"}},
    "coverage": {"type": "object"},
    "causal_chains": {"type": "array", "items": {"type": "object"}},
    "resources": {"type": "object", "required": ["scheduler_steps", "materialized_bytes", "source_actions", "transactions", "semantic_records", "evidence_bytes", "wall_time_ms"], "additionalProperties": false, "properties": {"scheduler_steps": {"$ref": "#/$defs/natural"}, "materialized_bytes": {"type": "object", "additionalProperties": {"$ref": "#/$defs/natural"}}, "source_actions": {"$ref": "#/$defs/natural"}, "transactions": {"$ref": "#/$defs/natural"}, "semantic_records": {"$ref": "#/$defs/natural"}, "evidence_bytes": {"$ref": "#/$defs/natural"}, "wall_time_ms": {"$ref": "#/$defs/natural"}}},
    "evidence_paths": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "natural": {"type": "integer", "minimum": 0}}
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myfuzz.local/schemas/scenario_runtime_manifest.v1.json",
  "title": "Scenario manifest derived from an independent ScenarioRunner identity",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scenario_id", "runner_identity", "schedule_order", "scheduler_policy_id", "reset_policy", "budget"],
  "properties": {
    "schema_version": {"const": "scenario_runtime_manifest.v1"},
    "scenario_id": {"$ref": "#/$defs/name"},
    "runner_identity": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "sessions", "memories", "windows", "ownership", "bindings"],
      "properties": {
        "schema_version": {"enum": ["scenario_manifest_identity.v1", "scenario_manifest_identity.v2"]},
        "sessions": {"type": "object", "minProperties": 1, "additionalProperties": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["type", "identity"], "properties": {"type": {"type": "string", "pattern": "^myfuzz\\.scenario\\."}, "identity": {"type": "object", "additionalProperties": false, "required": ["sources", "revision", "toolchain"], "properties": {"sources": {"type": "object", "additionalProperties": false, "required": ["schema_version", "files"], "properties": {"schema_version": {"const": "source_bundle.v1"}, "files": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"$ref": "#/$defs/name"}, "sha256": {"$ref": "#/$defs/digest"}}}}}}, "revision": {"$ref": "#/$defs/name"}, "toolchain": {"type": "object", "additionalProperties": false, "required": ["verilator", "c++"], "properties": {"verilator": {"$ref": "#/$defs/tool"}, "c++": {"$ref": "#/$defs/tool"}}}}}}}, {"type": "object", "additionalProperties": false, "required": ["type", "identity"], "properties": {"type": {"enum": ["myfuzz.local_harness.cpu_session.GeneratedCve2Session", "myfuzz.local_harness.gpio_session.GeneratedPulpGpioSession"]}, "identity": {"type": "object", "additionalProperties": false, "required": ["schema_version", "runtime_artifact", "build_identity", "command_timeout_seconds"], "properties": {"schema_version": {"const": "generated_local_session_identity.v1"}, "runtime_artifact": {"type": "object"}, "build_identity": {"type": "object"}, "command_timeout_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 3600}}}}}]}},
        "memories": {"type": "object", "additionalProperties": {"type": "object", "required": ["initialization_algorithm", "initialization_seed", "max_initialized_bytes", "regions"], "properties": {"initialization_algorithm": {"$ref": "#/$defs/name"}, "initialization_seed": {"$ref": "#/$defs/natural"}, "max_initialized_bytes": {"$ref": "#/$defs/positive"}, "regions": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["memory_id", "base", "size", "readable", "writable", "aliases"], "properties": {"memory_id": {"$ref": "#/$defs/name"}, "base": {"$ref": "#/$defs/natural"}, "size": {"$ref": "#/$defs/positive"}, "readable": {"type": "boolean"}, "writable": {"type": "boolean"}, "aliases": {"type": "array"}}}}}}},
        "windows": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "object", "required": ["device_id", "base", "size", "target_component", "target_type"], "properties": {"device_id": {"$ref": "#/$defs/name"}, "base": {"$ref": "#/$defs/natural"}, "size": {"$ref": "#/$defs/positive"}, "target_component": {"$ref": "#/$defs/name"}, "target_type": {"$ref": "#/$defs/name"}}}}},
        "ownership": {"type": "object", "additionalProperties": false, "required": ["fields", "owners"], "properties": {"fields": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["component_id", "port", "width"], "properties": {"component_id": {"$ref": "#/$defs/name"}, "port": {"$ref": "#/$defs/name"}, "width": {"$ref": "#/$defs/positive"}}}}, "owners": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["component_id", "port", "bit_offset", "width", "kind", "producer_ref"], "properties": {"component_id": {"$ref": "#/$defs/name"}, "port": {"$ref": "#/$defs/name"}, "bit_offset": {"$ref": "#/$defs/natural"}, "width": {"$ref": "#/$defs/positive"}, "kind": {"enum": ["source", "bound", "fixed"]}, "producer_ref": {"$ref": "#/$defs/name"}}}}}},
        "bindings": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["source_component", "source_port", "target_component", "target_port", "width", "source_bit_offset", "target_bit_offset"], "properties": {"source_component": {"$ref": "#/$defs/name"}, "source_port": {"$ref": "#/$defs/name"}, "target_component": {"$ref": "#/$defs/name"}, "target_port": {"$ref": "#/$defs/name"}, "width": {"$ref": "#/$defs/positive"}, "source_bit_offset": {"$ref": "#/$defs/natural"}, "target_bit_offset": {"$ref": "#/$defs/natural"}}}},
        "irq_pulses": {"type": "array", "items": {"type": "object", "required": ["binding", "width_cpu_ticks", "overrun_policy"], "properties": {"binding": {"type": "object"}, "width_cpu_ticks": {"$ref": "#/$defs/positive"}, "overrun_policy": {"$ref": "#/$defs/name"}}}},
        "host_sources": {"type": "object", "additionalProperties": false, "required": ["schema_version", "files"], "properties": {"schema_version": {"enum": ["scenario_host_sources.v1", "scenario_harness_host_sources.v2"]}, "files": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"$ref": "#/$defs/name"}, "sha256": {"$ref": "#/$defs/digest"}}}}}}
      }
    },
    "schedule_order": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/name"}},
    "scheduler_policy_id": {"$ref": "#/$defs/name"},
    "reset_policy": {"type": "object", "additionalProperties": false, "required": ["initial", "allowed", "scope", "component_timings"], "properties": {"initial": {"const": "cold_all"}, "allowed": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["warm_all", "cold_all"]}}, "scope": {"const": "all"}, "component_timings": {"type": "object", "minProperties": 1, "additionalProperties": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["hold_cycles", "release_cycles", "source_path", "source_sha256"], "properties": {"hold_cycles": {"$ref": "#/$defs/positive"}, "release_cycles": {"$ref": "#/$defs/natural"}, "source_path": {"$ref": "#/$defs/name"}, "source_sha256": {"$ref": "#/$defs/digest"}}}, {"type": "object", "additionalProperties": false, "required": ["schema_version", "artifact_digest", "driver_sha256", "hold_cycles", "release_cycles"], "properties": {"schema_version": {"const": "generated_local_reset.v1"}, "artifact_digest": {"$ref": "#/$defs/digest"}, "driver_sha256": {"$ref": "#/$defs/digest"}, "hold_cycles": {"$ref": "#/$defs/positive"}, "release_cycles": {"$ref": "#/$defs/positive"}}}]}}}},
    "budget": {"$ref": "scenario_manifest.v1.json#/properties/budget"}
  },
  "$defs": {"name": {"type": "string", "minLength": 1}, "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "natural": {"type": "integer", "minimum": 0}, "positive": {"type": "integer", "minimum": 1}, "tool": {"type": "object", "additionalProperties": false, "required": ["available", "version"], "properties": {"available": {"const": true}, "version": {"$ref": "#/$defs/name"}}}}
}

{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "interface_description.v1",
    "type": "object",
    "required": [
        "schema_version",
        "source",
        "endpoints"
    ],
    "properties": {
        "schema_version": {
            "const": "interface_description.v1"
        },
        "source": {
            "type": "object",
            "required": [
                "root",
                "revision",
                "top_module"
            ],
            "properties": {
                "root": {
                    "type": "string",
                    "minLength": 1
                },
                "revision": {
                    "type": "string",
                    "pattern": "^(?:git:[0-9a-f]{40}|sha256:[0-9a-f]{64})$"
                },
                "top_module": {
                    "type": "string",
                    "minLength": 1
                },
                "files": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "filelist": {
                    "type": "string",
                    "minLength": 1
                },
                "include_roots": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "repositories": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "required": ["path", "revision"],
                        "properties": {
                            "path": {"type": "string", "minLength": 1},
                            "revision": {"type": "string", "pattern": "^git:[0-9a-f]{40}$"}
                        },
                        "additionalProperties": false
                    }
                },
                "elaboration": {
                    "type": "object",
                    "required": ["frontend"],
                    "properties": {
                        "frontend": {"const": "verilator-json"},
                        "warning_policy": {"const": "recorded-nonfatal"},
                        "defines": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "required": ["name", "value"],
                                "properties": {
                                    "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
                                    "value": {"type": "string", "pattern": "^[A-Za-z0-9_]+$"}
                                },
                                "additionalProperties": false
                            }
                        },
                        "parameters": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "required": ["name", "value"],
                                "properties": {
                                    "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
                                    "value": {"type": "string", "pattern": "^-?(?:0|[1-9][0-9]*)$"}
                                },
                                "additionalProperties": false
                            }
                        }
                    },
                    "additionalProperties": false
                }
            },
            "additionalProperties": true
        },
        "endpoints": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "endpoint_id",
                    "function"
                ],
                "properties": {
                    "endpoint_id": {
                        "type": "string",
                        "minLength": 1
                    },
                    "function": {
                        "type": "string",
                        "minLength": 1
                    },
                    "required": {
                        "type": "boolean"
                    },
                    "module": {
                        "type": "string",
                        "minLength": 1
                    },
                    "hierarchy": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "minLength": 1
                        }
                    },
                    "aliases": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "minLength": 1
                        }
                    },
                    "protocol": {
                        "type": "array",
                        "minItems": 2,
                        "maxItems": 2,
                        "items": {
                            "type": "string",
                            "minLength": 1
                        }
                    },
                    "fields": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "required": [
                                "role"
                            ],
                            "properties": {
                                "role": {
                                    "type": "string",
                                    "minLength": 1
                                },
                                "aliases": {
                                    "type": "array",
                                    "items": {
                                        "type": "string",
                                        "minLength": 1
                                    }
                                },
                                "required": {
                                    "type": "boolean"
                                },
                                "physical": {
                                    "type": "object",
                                    "required": ["port", "member_path"],
                                    "properties": {
                                        "port": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
                                        "member_path": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}}
                                    },
                                    "additionalProperties": false
                                }
                            },
                            "allOf": [{"not": {"required": ["aliases", "physical"]}}],
                            "additionalProperties": true
                        }
                    }
                },
                "additionalProperties": true
            }
        }
    },
    "additionalProperties": true
}

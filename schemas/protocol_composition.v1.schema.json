{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "protocol_composition.v1",
  "type": "object",
  "required": ["schema_version", "target", "components", "runtime"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "protocol_composition.v1"},
    "target": {
      "type": "object",
      "required": ["kind", "base_config", "address_width", "data_width"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "ibex_core"},
        "base_config": {"const": "ibex_multicomponent_ip"},
        "address_width": {"const": 32},
        "data_width": {"const": 32}
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["component_id", "component_type", "protocol", "base", "size", "parameters", "external_input"],
        "additionalProperties": false,
        "properties": {
          "component_id": {"type": "string", "minLength": 1},
          "component_type": {"enum": ["ram", "timer", "gpio", "uart", "spi"]},
          "protocol": {
            "type": "object",
            "required": ["id", "version"],
            "additionalProperties": false,
            "properties": {
              "id": {"enum": ["apb", "axi4-lite", "tl-ul"]},
              "version": {"type": "string", "minLength": 1}
            }
          },
          "base": {"type": "integer", "minimum": 0, "multipleOf": 4096},
          "size": {"type": "integer", "enum": [4096, 65536]},
          "irq": {"type": ["integer", "null"], "minimum": 0, "maximum": 14},
          "parameters": {
            "type": "object",
            "additionalProperties": {"type": "integer"}
          },
          "external_input": {"type": "boolean"}
        }
      }
    },
    "runtime": {
      "type": "object",
      "required": ["seed", "duration_seconds", "checkpoint_seconds"],
      "additionalProperties": false,
      "properties": {
        "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "duration_seconds": {"type": "integer", "minimum": 1},
        "checkpoint_seconds": {"type": "integer", "minimum": 1}
      }
    }
  }
}

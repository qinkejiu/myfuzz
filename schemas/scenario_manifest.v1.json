{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myfuzz.local/schemas/scenario_manifest.v1.json",
  "title": "Persistent independent harness scenario manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scenario_id", "components", "toolchain", "ownership", "bindings", "schedule_order", "scheduler_policy_id", "reset_policy", "initializer_id", "address_map", "budget"],
  "properties": {
    "schema_version": {"const": "scenario_manifest.v1"},
    "scenario_id": {"$ref": "#/$defs/name"},
    "components": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["component_id", "harness_kind", "source_sha256", "harness_sha256", "profile_sha256"], "properties": {"component_id": {"$ref": "#/$defs/name"}, "harness_kind": {"const": "independent_rtl"}, "source_sha256": {"$ref": "#/$defs/digest"}, "harness_sha256": {"$ref": "#/$defs/digest"}, "profile_sha256": {"$ref": "#/$defs/digest"}}}},
    "toolchain": {"type": "object", "additionalProperties": false, "required": ["verilator", "compiler", "rfuzz", "identity_sha256"], "properties": {"verilator": {"$ref": "#/$defs/name"}, "compiler": {"$ref": "#/$defs/name"}, "rfuzz": {"$ref": "#/$defs/name"}, "identity_sha256": {"$ref": "#/$defs/digest"}}},
    "ownership": {"type": "object", "additionalProperties": false, "required": ["fields", "owners"], "properties": {"fields": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["component_id", "port", "width"], "properties": {"component_id": {"$ref": "#/$defs/name"}, "port": {"$ref": "#/$defs/name"}, "width": {"$ref": "#/$defs/positive"}}}}, "owners": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["component_id", "port", "bit_offset", "width", "kind", "producer_ref"], "properties": {"component_id": {"$ref": "#/$defs/name"}, "port": {"$ref": "#/$defs/name"}, "bit_offset": {"$ref": "#/$defs/natural"}, "width": {"$ref": "#/$defs/positive"}, "kind": {"enum": ["source", "bound", "fixed"]}, "producer_ref": {"$ref": "#/$defs/name"}}}}}},
    "bindings": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["producer_ref", "target_component", "target_port", "bit_offset", "width"], "properties": {"producer_ref": {"$ref": "#/$defs/name"}, "target_component": {"$ref": "#/$defs/name"}, "target_port": {"$ref": "#/$defs/name"}, "bit_offset": {"$ref": "#/$defs/natural"}, "width": {"$ref": "#/$defs/positive"}}}},
    "schedule_order": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/name"}},
    "scheduler_policy_id": {"$ref": "#/$defs/name"},
    "reset_policy": {"type": "object", "additionalProperties": false, "required": ["initial", "allowed", "scope", "hold_cycles", "release_cycles"], "properties": {"initial": {"const": "cold_all"}, "allowed": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["warm_all", "cold_all"]}, "contains": {"const": "cold_all"}}, "scope": {"const": "all"}, "hold_cycles": {"$ref": "#/$defs/positive"}, "release_cycles": {"$ref": "#/$defs/positive"}}},
    "initializer_id": {"$ref": "#/$defs/name"},
    "address_map": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["memory_id", "base", "size", "permissions", "owner_component"], "properties": {"memory_id": {"$ref": "#/$defs/name"}, "base": {"$ref": "#/$defs/natural"}, "size": {"$ref": "#/$defs/positive"}, "permissions": {"enum": ["r", "rw", "rx", "rwx"]}, "owner_component": {"$ref": "#/$defs/name"}}}},
    "budget": {"type": "object", "additionalProperties": false, "required": ["max_local_cycles_per_component", "max_scheduler_steps", "max_materialized_bytes_per_memory", "max_source_actions", "max_transactions", "max_semantic_records", "max_evidence_bytes", "evidence_termination_reserve_bytes", "max_wall_time_ms", "max_quiesce_steps", "build_workers", "waveform_enabled"], "properties": {"max_local_cycles_per_component": {"$ref": "#/$defs/positive"}, "max_scheduler_steps": {"$ref": "#/$defs/positive"}, "max_materialized_bytes_per_memory": {"$ref": "#/$defs/positive"}, "max_source_actions": {"$ref": "#/$defs/natural"}, "max_transactions": {"$ref": "#/$defs/positive"}, "max_semantic_records": {"$ref": "#/$defs/positive"}, "max_evidence_bytes": {"$ref": "#/$defs/positive"}, "evidence_termination_reserve_bytes": {"$ref": "#/$defs/positive"}, "max_wall_time_ms": {"$ref": "#/$defs/positive"}, "max_quiesce_steps": {"type": "integer", "minimum": 0, "maximum": 4096}, "build_workers": {"$ref": "#/$defs/positive"}, "waveform_enabled": {"type": "boolean"}}}
  },
  "$defs": {"name": {"type": "string", "minLength": 1}, "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "natural": {"type": "integer", "minimum": 0}, "positive": {"type": "integer", "minimum": 1}}
}
